# ---------------------------------------------------------------------------
# AI-SOC Backend Configuration — EXAMPLE FILE
#
# DO NOT put real secrets in this file.
# Copy this to backend/.env and fill in real values.
# backend/.env is gitignored and must never be committed.
# ---------------------------------------------------------------------------

# Environment: development | production
APP_ENV=development

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# JWT RS256 Keys
# ---------------------------------------------------------------------------
# Paths to RSA key files generated by: python generate_keys.py
# Relative paths are resolved from the backend/ directory.
# These key FILES must never be committed — they are gitignored via backend/keys/.
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME_DB_PASSWORD@localhost:5432/aisoc
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_WITH: python -c "import secrets; print(secrets.token_urlsafe(32))"

# ---------------------------------------------------------------------------
# External API URL (used by frontend server-side actions)
# ---------------------------------------------------------------------------
API_URL=http://localhost:8000
